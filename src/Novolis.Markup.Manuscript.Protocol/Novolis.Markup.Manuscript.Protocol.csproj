<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Markup.Manuscript.Protocol</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Markup.Manuscript.Protocol</RootNamespace>
    <Description>NMP/1 typed manuscript protocol: workspace discovery, catalog, metadata, and diagnostics.</Description>
    <PackageTags>manuscript;nmp;protocol;yaml;markdown;novolis</PackageTags>
