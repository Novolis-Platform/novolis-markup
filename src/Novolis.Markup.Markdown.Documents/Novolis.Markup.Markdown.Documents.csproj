<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Markup.Markdown.Documents</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Markup.Markdown.Documents</RootNamespace>
    <Description>Map Novolis.Markup.Markdown documents to Novolis.Documents PagedDocument and export PDF via Documents.Skia.</Description>
    <PackageTags>markdown;pdf;documents;skia;export;csharp;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Documents" />
    <LibraryReference Include="Novolis.Documents.Layout" />
    <LibraryReference Include="Novolis.Documents.Skia" />
    <LibraryReference Include="Novolis.Math.Measure" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <ProjectReference Include="..\Novolis.Markup.Markdown\Novolis.Markup.Markdown.csproj" />
  </ItemGroup>
</Project>
