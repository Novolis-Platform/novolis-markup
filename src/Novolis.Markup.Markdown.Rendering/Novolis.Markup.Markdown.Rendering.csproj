<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Markup.Markdown.Rendering</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Markup.Markdown.Rendering</RootNamespace>
    <Description>Markdig HTML rendering and document export (HTML, PDF) for Markdown source.</Description>
    <PackageTags>markdown;markdig;html;pdf;questpdf;export;rendering;csharp;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="QuestPDF" />
    <ProjectReference Include="..\Novolis.Markup.Markdown\Novolis.Markup.Markdown.csproj" />
    <ProjectReference Include="..\Novolis.Markup.Html\Novolis.Markup.Html.csproj" />
  </ItemGroup>
</Project>
