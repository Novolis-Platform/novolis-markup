    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="Novolis.IO.Paths" Version="2026.1.*" />
    <PackageVersion Include="QuestPDF" Version="2025.7.4" />
    <PackageVersion Include="Svg.Skia" Version="3.7.0" />
    <PackageVersion Include="TUnit" Version="1.44.39" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

  </ItemGroup>
</Project>
